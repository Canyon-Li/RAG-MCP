# ============================================================
# 环境变量模板 — 复制为 .env 后按需填写（.env 已 gitignore，不会入库）
#   cp .env.example .env
#
# 当前只有评估 judge 用到 env。检索链路（LLM/Embedding/Vision）
# 走 config/settings.yaml + 本地 ollama，不需要任何 key。
# ============================================================

# ---- 评估 judge（RagasEvaluator，scripts/evaluate.py 启动时自动加载 .env）----

# judge 提供方：ollama（默认，本地零成本）| deepseek（云端，快且稳）
# 切 deepseek 时必须同时填 DEEPSEEK_API_KEY
RAGAS_JUDGE_PROVIDER=deepseek
RAGAS_JUDGE_MODEL=deepseek-v4-flash

# DeepSeek judge 的 API key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：DeepSeek 端点覆盖（默认 https://api.deepseek.com，一般不用动）
# RAGAS_JUDGE_BASE_URL=https://api.deepseek.com

# ---- 本地 ollama judge（RAGAS_JUDGE_PROVIDER=ollama 时的端点，默认即可）----
# OLLAMA_BASE_URL=http://localhost:11434
